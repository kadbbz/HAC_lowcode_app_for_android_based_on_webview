<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      离线填报表单项尺寸标定（分页布局按此执行；平铺布局沿用同一套字段行标准）。

      表单项 = 字段名（标签行）+ 字段表单组件（控件），二者上下排列。
      默认最小高度 = 上下内边距 12 + 标签行 18 + 标签间距 8 + 控件 46 + 上下内边距 12 = 96。
    -->
    <dimen name="offline_form_item_min_height">96dp</dimen>
    <dimen name="offline_form_item_padding_horizontal">16dp</dimen>
    <dimen name="offline_form_item_padding_vertical">12dp</dimen>
    <dimen name="offline_form_item_label_gap">8dp</dimen>
    <dimen name="offline_form_field_min_height">46dp</dimen>

    <!--
      标签 + 控件「左右排列」的全局规则（当前仅开关组件启用 auto）：
      空间足够时标签在左、控件在右；空间不足时自动退回上下排列。
    -->
    <dimen name="offline_form_field_inline_gap">12dp</dimen>
    <dimen name="offline_form_field_inline_min_height">46dp</dimen>
    <dimen name="offline_form_field_stacked_min_height">72dp</dimen>
    <dimen name="offline_form_control_min_width_switch">64dp</dimen>
    <!-- 左右排列时标签最多占行宽的比例，超过即视为放不下、退回上下排列。 -->
    <item name="offline_form_field_inline_label_max_ratio" type="fraction">40%</item>
</resources>
