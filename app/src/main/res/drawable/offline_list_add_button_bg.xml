<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#F4F7FA" />
            <stroke
                android:width="1dp"
                android:color="#E1E7EE"
                android:dashGap="3dp"
                android:dashWidth="4dp" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/offline_form_brand_tint" />
            <stroke
                android:width="1dp"
                android:color="@color/huozige_blue"
                android:dashGap="3dp"
                android:dashWidth="4dp" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/offline_form_field_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/offline_form_line_strong"
                android:dashGap="3dp"
                android:dashWidth="4dp" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
