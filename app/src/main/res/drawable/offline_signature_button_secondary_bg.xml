<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/offline_form_brand_tint" />
            <stroke
                android:width="1dp"
                android:color="@color/huozige_blue" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="@color/offline_form_line_strong" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
