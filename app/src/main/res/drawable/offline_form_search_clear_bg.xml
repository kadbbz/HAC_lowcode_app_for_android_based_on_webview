<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内缩 1dp：视觉圆点比触摸区域略小，避免压在输入框内边距上显得突兀 -->
    <item android:state_pressed="true">
        <inset android:inset="1dp">
            <shape android:shape="oval">
                <solid android:color="@color/offline_form_search_clear_bg_pressed" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="1dp">
            <shape android:shape="oval">
                <solid android:color="@color/offline_form_search_clear_bg" />
            </shape>
        </inset>
    </item>
</selector>
