<?xml version="1.0" encoding="utf-8"?>
<!--
  选择框的底部抽屉滚轮：标题栏（取消 / 标题 / 确定）+ 单列滚轮。
  样式与日期/时间滚轮抽屉保持一致，点「确定」才提交。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/option_wheel_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="start|center_vertical"
            android:minWidth="52dp"
            android:text="@string/offline_button_cancel"
            android:textColor="@color/offline_form_sec"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/option_wheel_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/offline_form_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/option_wheel_confirm"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="end|center_vertical"
            android:minWidth="52dp"
            android:text="@string/offline_button_confirm"
            android:textColor="@color/huozige_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offline_form_line" />

    <com.zyyoona7.wheel.WheelView
        android:id="@+id/wheel_option"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
