<?xml version="1.0" encoding="utf-8"?>
<!-- 添加图片瓦片：与图片卡同高（图片区 1:1 + 28dp 删除条预留高度），虚线 + 品牌色「+」，内容整卡垂直居中。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/image_add_tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/offline_image_add_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- 仅用于撑出「图片区 1:1 + 删除条 28dp」的目标高度，不参与展示。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.huozige.lab.container.offlineform.formitem.image.SquareFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="28dp" />

    </LinearLayout>

    <!-- 真正展示的「+ 添加」内容，居中于整张瓦片。 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_offline_quick_add"
            android:tint="@color/huozige_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/offline_button_add_image"
            android:textColor="@color/offline_form_muted"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
