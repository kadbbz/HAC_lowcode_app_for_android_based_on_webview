<?xml version="1.0" encoding="utf-8"?>
<!--
  签名项：不再套卡片，和普通字段一样直接平铺。
  两行内容：第 1 行「X 人待签 · Y 人已签」（右侧箭头提示可点），第 2 行签名进度条；
  整块可点击，打开人员签名抽屉。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="@dimen/offline_form_item_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/offline_form_item_padding_horizontal"
    android:paddingTop="@dimen/offline_form_item_padding_vertical"
    android:paddingEnd="@dimen/offline_form_item_padding_horizontal"
    android:paddingBottom="@dimen/offline_form_item_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/offline_form_item_label_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_form_field_title_placeholder"
            android:textColor="@color/offline_form_sec"
            android:textSize="@dimen/offline_form_field_label_text_size" />

        <TextView
            android:id="@+id/tv_required"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="*"
            android:textColor="@color/offline_form_danger"
            android:textSize="@dimen/offline_form_field_label_text_size"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 第 1 行：待签 / 已签人数，右侧箭头提示可打开抽屉；与其它字段的控件行同高（46dp）并垂直居中，
         保证「字段名 → 内容」的视觉间距与文本/选择等可交互项一致 -->
    <TextView
        android:id="@+id/signature_summary_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/offline_form_field_min_height"
        android:drawableEnd="@drawable/ic_offline_chevron"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:textColor="@color/offline_form_ink"
        android:textSize="@dimen/offline_form_field_value_text_size" />

    <TextView
        android:id="@+id/signature_empty"
        android:layout_width="match_parent"
        android:layout_height="@dimen/offline_form_field_min_height"
        android:gravity="center_vertical"
        android:text="@string/offline_text_no_signature_users"
        android:textColor="@color/offline_form_muted"
        android:textSize="@dimen/offline_form_chrome_meta_text_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="@color/offline_form_danger"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
