<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/offline_form_item_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/offline_form_item_padding_horizontal"
    android:paddingTop="@dimen/offline_form_item_padding_vertical"
    android:paddingEnd="@dimen/offline_form_item_padding_horizontal"
    android:paddingBottom="@dimen/offline_form_item_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/offline_form_item_label_gap"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_form_field_title_placeholder"
            android:textColor="@color/offline_form_muted"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tv_required"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="*"
            android:textColor="@color/offline_form_danger"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/file_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <Button
        android:id="@+id/btn_upload_file"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/offline_image_action_button_bg"
        android:contentDescription="@string/offline_button_upload_file"
        android:drawableStart="@drawable/ic_upload_file"
        android:drawablePadding="6dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/offline_button_upload_file"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="@color/offline_form_danger"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
