<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/offline_form_page_bg">

    <!-- 步骤 Tab -->
    <LinearLayout
        android:id="@+id/layout_step_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:tabIndicatorColor="@color/huozige_blue"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/huozige_blue"
                app:tabTextColor="@color/offline_form_muted" />

            <ImageView
                android:id="@+id/hint_step_scroll_left"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@color/white"
                android:clickable="true"
                android:contentDescription="@null"
                android:elevation="2dp"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_offline_step_arrow_left"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/hint_step_scroll_right"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="@color/white"
                android:clickable="true"
                android:contentDescription="@null"
                android:elevation="2dp"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_offline_step_arrow_right"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- 步骤 Tab 下方发丝线（分页布局且有多个步骤时显示，用于分隔 Tab 与页头） -->
    <View
        android:id="@+id/divider_step_bar_footer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offline_form_line"
        android:visibility="gone" />

    <!-- 分页指示器（仅逐组分页布局、且当前页为分组时显示） -->
    <LinearLayout
        android:id="@+id/layout_page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_page_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/offline_form_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_page_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/huozige_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/button_group_directory"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/offline_form_ghost_button_bg"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/offline_button_group_directory"
                android:textColor="@color/offline_form_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_page_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/offline_form_page_progress_track"
            android:orientation="horizontal"
            android:weightSum="1">

            <View
                android:id="@+id/view_page_progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/offline_form_page_progress_fill" />

        </LinearLayout>

    </LinearLayout>

    <!-- 筛选行（Step 级）：非搜索态为分段筛选 + 搜索按钮；搜索态整行替换为输入框 -->
    <LinearLayout
        android:id="@+id/layout_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:id="@+id/layout_filter_segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioGroup
                android:id="@+id/seg_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/offline_form_seg_track"
                android:orientation="horizontal"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/filter_all"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/offline_form_seg_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/offline_filter_all"
                    android:textColor="@color/offline_form_seg_text"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/filter_unfilled"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/offline_form_seg_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/offline_filter_unfilled"
                    android:textColor="@color/offline_form_seg_text"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/filter_filled"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/offline_form_seg_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/offline_filter_filled"
                    android:textColor="@color/offline_form_seg_text"
                    android:textSize="12.5sp" />

            </RadioGroup>

            <TextView
                android:id="@+id/button_search_filter"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/offline_form_ghost_button_bg"
                android:drawableStart="@drawable/ic_offline_search"
                android:drawablePadding="5dp"
                android:drawableTint="@color/offline_form_ink"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:text="@string/offline_filter_search"
                android:textColor="@color/offline_form_ink"
                android:textSize="12.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_search_input"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/custom_form_bg_edittext_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/edit_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/offline_hint_field_search"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:textColor="@color/offline_form_ink"
                android:textColorHint="@color/offline_form_muted"
                android:textSize="13.5sp" />

            <ImageView
                android:id="@+id/button_clear_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/offline_form_search_clear_bg"
                android:contentDescription="@string/offline_button_clear_search"
                android:padding="5dp"
                android:src="@drawable/ic_offline_search_clear"
                android:tint="@color/offline_form_sec" />

        </LinearLayout>

    </LinearLayout>

    <!-- 分页布局下内容整页铺白，用一条发丝线与顶部筛选行分隔（平铺布局内容区为灰色页面底，无需此线） -->
    <View
        android:id="@+id/divider_filter_footer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offline_form_line"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:padding="4dp" />

            <TextView
                android:id="@+id/text_form_bottom_hint"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:gravity="center"
                android:text="@string/offline_text_reach_bottom"
                android:textColor="@color/gray"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_item_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/offline_form_nav_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/button_previous_item"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/offline_form_ghost_button_bg"
            android:gravity="center"
            android:text="@string/offline_button_previous_item"
            android:textColor="@color/offline_form_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/button_next_item"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/offline_form_primary_button_bg"
            android:gravity="center"
            android:text="@string/offline_button_next_item"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
