<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/offline_form_page_bg">

    <!-- 统一定制 Header：返回 / 当前 Step 名称 / 网络状态 tag -->
    <include layout="@layout/offline_form_header" />

    <!-- 步骤 Tab -->
    <LinearLayout
        android:id="@+id/layout_step_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:tabIndicatorColor="@color/huozige_blue"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/huozige_blue"
                app:tabTextAppearance="@style/OfflineFormTabTextAppearance"
                app:tabTextColor="@color/offline_form_muted" />

            <ImageView
                android:id="@+id/hint_step_scroll_left"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@color/white"
                android:clickable="true"
                android:contentDescription="@null"
                android:elevation="2dp"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_offline_step_arrow_left"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/hint_step_scroll_right"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="@color/white"
                android:clickable="true"
                android:contentDescription="@null"
                android:elevation="2dp"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_offline_step_arrow_right"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- 步骤 Tab 下方发丝线（分页布局且有多个步骤时显示，用于分隔 Tab 与页头） -->
    <View
        android:id="@+id/divider_step_bar_footer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offline_form_line"
        android:visibility="gone" />

    <!--
        分页指示器（仅逐组分页布局、且当前页为分组时显示）。
        页标题行 38dp 高（与右侧分组 / 筛选按钮同高）；上下各留 10dp（下边距即标题与筛选行之间的间距，
        放在标题行自身，不随筛选行收起而消失）。
    -->
    <LinearLayout
        android:id="@+id/layout_page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_page_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/offline_form_ink"
                android:textSize="@dimen/offline_form_page_title_text_size"
                android:textStyle="bold" />

            <!-- 组序号与「目录」合并为一个按钮：按钮上直接显示「第 x / y 组」，点击打开分组目录 -->
            <TextView
                android:id="@+id/button_group_directory"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/offline_form_ghost_button_bg"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/huozige_blue"
                android:textSize="@dimen/offline_form_chrome_meta_text_size"
                android:textStyle="bold"
                tools:text="第 1 / 3 组" />

            <!--
                分页分组页的筛选入口：与分组按钮同款方形描边按钮（38dp × 38dp、10dp 圆角），
                点击展开 / 收起下方筛选行；没有表单项的页面不显示。
            -->
            <ImageView
                android:id="@+id/button_filter_toggle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/offline_form_ghost_button_bg"
                android:clickable="true"
                android:contentDescription="@string/offline_filter_toggle"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/manage_search_24"
                android:tint="@color/offline_form_ink"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!--
        筛选行（Step 级）：非搜索态为分段筛选 + 搜索按钮；搜索态整行替换为输入框。
        标题与筛选行之间的 10dp 间距已放到页标题行的下边距，这里不再留上边距。
    -->
    <LinearLayout
        android:id="@+id/layout_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_filter_segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioGroup
                android:id="@+id/seg_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/offline_form_seg_track"
                android:orientation="horizontal"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/filter_all"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/offline_form_seg_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/offline_filter_all"
                    android:textColor="@color/offline_form_seg_text"
                    android:textSize="@dimen/offline_form_chrome_text_size" />

                <RadioButton
                    android:id="@+id/filter_unfilled"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/offline_form_seg_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/offline_filter_unfilled"
                    android:textColor="@color/offline_form_seg_text"
                    android:textSize="@dimen/offline_form_chrome_text_size" />

                <RadioButton
                    android:id="@+id/filter_filled"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/offline_form_seg_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/offline_filter_filled"
                    android:textColor="@color/offline_form_seg_text"
                    android:textSize="@dimen/offline_form_chrome_text_size" />

            </RadioGroup>

            <!--
                搜索按钮与分段筛选轨道同高（34dp 项 + 上下 2dp 内衬 = 38dp），
                圆角沿用 ghost 按钮背景的 10dp，与页脚「上一项 / 下一项」一致。
            -->
            <TextView
                android:id="@+id/button_search_filter"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/offline_form_ghost_button_bg"
                android:drawableStart="@drawable/ic_offline_search"
                android:drawablePadding="5dp"
                android:drawableTint="@color/offline_form_ink"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:text="@string/offline_filter_search"
                android:textColor="@color/offline_form_ink"
                android:textSize="@dimen/offline_form_chrome_text_size"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 搜索态：标准控件样式的输入框（38dp 高、10dp 圆角），与筛选行其他组件同规格 -->
        <LinearLayout
            android:id="@+id/layout_search_input"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/custom_form_bg_edittext_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/edit_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/offline_hint_field_search"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:textColor="@color/offline_form_ink"
                android:textColorHint="@color/offline_form_muted"
                android:textSize="@dimen/offline_form_chrome_text_size" />

        </LinearLayout>

        <!-- 原输入框内的「×」移到输入框右侧，文案改为「取消」；仅搜索态显示 -->
        <TextView
            android:id="@+id/button_cancel_search"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/offline_button_cancel"
            android:textColor="@color/huozige_blue"
            android:textSize="@dimen/offline_form_chrome_text_size"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 分页布局下内容整页铺白，用一条发丝线与顶部筛选行分隔（平铺布局内容区为灰色页面底，无需此线） -->
    <View
        android:id="@+id/divider_filter_footer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offline_form_line"
        android:visibility="gone" />

    <!--
        表单区域四周各留 12dp 外边距：页面底色为浅灰，分页布局下滚动区铺白，
        这样白色表单区与上方的分页指示器 / 筛选行、下方的底部导航、左右屏边之间都能明显分开。
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:padding="4dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!--
        底部操作栏：左半区 = 「上一项 / 下一项」图标按钮（白底描边），右半区 = 「保存」主按钮。
        保存是整条栏里唯一的主题色按钮：保存当前页（当前表单组）的填写数据，停留在本页。
    -->
    <LinearLayout
        android:id="@+id/layout_item_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/offline_form_nav_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/layout_nav_buttons"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_previous_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/offline_form_ghost_button_bg"
                android:contentDescription="@string/offline_button_previous_item"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_offline_chevron_left_24"
                android:tint="@color/offline_form_ink" />

            <ImageButton
                android:id="@+id/button_next_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/offline_form_ghost_button_bg"
                android:contentDescription="@string/offline_button_next_item"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_offline_chevron_right_24"
                android:tint="@color/offline_form_ink" />

        </LinearLayout>

        <TextView
            android:id="@+id/button_save_page"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/offline_form_primary_button_bg"
            android:gravity="center"
            android:text="@string/offline_button_save"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
