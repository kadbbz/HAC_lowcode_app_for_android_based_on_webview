<?xml version="1.0" encoding="utf-8"?>
<!--
  列表项编辑抽屉：头部（取消 / 标题 / 删除图标）+ 子字段内容 + 底部「完成」。
  高度按内容收敛，超过上限后内容区内部滚动（见 OfflineFormSheetHeight）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/offline_sheet_handle_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/offline_form_item_padding_horizontal"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/offline_form_item_padding_horizontal"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/list_item_sheet_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_button_cancel"
            android:textColor="@color/offline_form_sec"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/list_item_sheet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/offline_form_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/list_item_sheet_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/offline_form_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/list_item_sheet_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/offline_button_delete"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete_image"
            android:tint="@color/offline_form_danger" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offline_form_line" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/list_item_sheet_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/list_item_sheet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/offline_form_line" />

    <TextView
        android:id="@+id/list_item_sheet_done"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="@dimen/offline_form_item_padding_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/offline_form_item_padding_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/offline_form_primary_button_bg"
        android:gravity="center"
        android:text="@string/offline_list_item_sheet_done"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
