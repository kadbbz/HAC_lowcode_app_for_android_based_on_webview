<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/offline_form_item_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/offline_form_item_padding_horizontal"
    android:paddingTop="@dimen/offline_form_item_padding_vertical"
    android:paddingEnd="@dimen/offline_form_item_padding_horizontal"
    android:paddingBottom="@dimen/offline_form_item_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/offline_form_item_label_gap"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/offline_form_muted"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tv_required"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="*"
            android:textColor="@color/offline_form_danger"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <RadioGroup
        android:id="@+id/radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/offline_form_field_min_height"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="@color/offline_form_danger"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
