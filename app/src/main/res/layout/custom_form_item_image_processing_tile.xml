<?xml version="1.0" encoding="utf-8"?>
<!-- 图片处理中占位：与图片卡同高（图片区 1:1 + 28dp 删除条预留高度），内容垂直居中。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/offline_image_processing_tile_bg">

    <!-- 仅用于撑出与图片卡一致的高度。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.huozige.lab.container.offlineform.formitem.image.SquareFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="28dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="@color/huozige_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/offline_image_processing"
            android:textColor="@color/offline_form_muted"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
