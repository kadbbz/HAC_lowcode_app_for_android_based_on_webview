<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 统一定制 Header：应用首页 / 离线表单列表 / 网络状态 tag -->
    <include layout="@layout/offline_form_header" />

    <!--
        搜索行：左侧搜索框，右侧筛选按钮。
        筛选条件（全部 / 已导出 / 未导出）收进底部抽屉，不再占用独立一行；
        按钮为中性灰描边（muted outline），不使用主题色；当前筛选不是「全部」时
        仅以更深的灰色描边 + 深色图标提示，避免列表处于筛选态却不易察觉。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/searchEditText"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/custom_form_bg_edittext_normal"
            android:hint="@string/offline_hint_search"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/buttonFilter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/offline_form_filter_button_bg"
            android:contentDescription="@string/offline_title_filter"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_offline_filter"
            android:tint="@color/offline_form_filter_icon_tint" />

    </LinearLayout>

    <!--
        列表上下 padding 6dp + 卡片上下外边距 6dp = 12dp，与搜索行的上边距（12dp）及
        搜索行到首卡的间距一致；左右 4dp + 卡片 8dp = 12dp，与搜索行左右外边距对齐。
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp" />

</LinearLayout>
