<?xml version="1.0" encoding="utf-8"?>
<!--
  开关项：全局响应式规则——宽度足够时「标签在左、开关在右」，
  空间不足时自动退回「标签在上、开关在下」。判定逻辑见 ResponsiveFieldRow。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/offline_form_item_padding_horizontal"
    android:paddingTop="@dimen/offline_form_item_padding_vertical"
    android:paddingEnd="@dimen/offline_form_item_padding_horizontal"
    android:paddingBottom="@dimen/offline_form_item_padding_vertical">

    <com.huozige.lab.container.offlineform.formitem.ResponsiveFieldRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rf_controlMinWidth="@dimen/offline_form_control_min_width_switch">

        <!-- 子 View 顺序固定：第 1 个为标签组，第 2 个为控件 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/offline_form_sec"
                android:textSize="@dimen/offline_form_field_label_text_size" />

            <TextView
                android:id="@+id/tv_required"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="*"
                android:textColor="@color/offline_form_danger"
                android:textSize="@dimen/offline_form_field_label_text_size"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/offline_form_field_min_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 自绘开关：轨道尺寸即控件尺寸、拨手完全内嵌，居左/居右都不会因放大绘制被父布局裁剪；
                 右缘按光学基线内缩，与日期图标字形、复选框方框的视觉右缘对齐 -->
            <com.huozige.lab.container.offlineform.formitem.switchitem.OfflineSwitchView
                android:id="@+id/switch_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/offline_form_field_switch_end_inset" />

            <CheckBox
                android:id="@+id/checkbox_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/offline_form_field_checkbox_end_inset"
                android:visibility="gone" />

        </LinearLayout>

    </com.huozige.lab.container.offlineform.formitem.ResponsiveFieldRow>

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="@color/offline_form_danger"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
