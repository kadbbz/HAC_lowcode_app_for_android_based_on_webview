<?xml version="1.0" encoding="utf-8"?>
<!-- 日期/时间选择项：字段名在上、选择结果在下；取值行不套边框 / 卡片，右对齐并保留尾部箭头。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/offline_form_item_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/offline_form_item_padding_horizontal"
    android:paddingTop="@dimen/offline_form_item_padding_vertical"
    android:paddingEnd="@dimen/offline_form_item_padding_horizontal"
    android:paddingBottom="@dimen/offline_form_item_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/offline_form_item_label_gap"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_form_field_title_placeholder"
            android:textColor="@color/offline_form_sec"
            android:textSize="@dimen/offline_form_field_label_text_size" />

        <TextView
            android:id="@+id/tv_required"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="*"
            android:textColor="@color/offline_form_danger"
            android:textSize="@dimen/offline_form_field_label_text_size"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 取值行：不套边框 / 卡片，水印与取值左对齐，图标固定右侧 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/offline_form_field_min_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/offline_form_ink"
            android:textColorHint="@color/offline_form_muted"
            android:textSize="@dimen/offline_form_field_value_text_size" />

        <!-- 日期 / 时间图标：默认日历，时间模式在代码里换成时钟 -->
        <ImageView
            android:id="@+id/iv_value_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/offline_form_field_icon_gap"
            android:layout_marginEnd="@dimen/offline_form_field_icon_end_inset"
            android:contentDescription="@null"
            android:src="@drawable/calendar_month_24" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="@color/offline_form_danger"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
